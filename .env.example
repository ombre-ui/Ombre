# Ombre environment template.
# Copy to .env.local (gitignored) and fill in values. NEVER commit real values.
#
# Read only by the server-side /api layer (Vercel functions in api/). Nothing in src/ reads them.
#
# SECURITY RULES
# - These are SERVER-ONLY variables. Do not give any Supabase value a VITE_ prefix:
#   Vite inlines VITE_* variables into the browser bundle.
# - Never place a Supabase secret key, service-role key, JWT secret or any AI
#   provider key in this file, in the frontend, or in git.

# Supabase project URL and publishable (anon) key.
# Local stack: run `supabase start`, then copy the values from `supabase status`.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Exact origin(s) allowed to call the /api layer, comma separated. No paths, no wildcards.
# Local development runs through `npm run dev:vercel` (vercel dev) on port 3000.
# Production / the fixed staging domain: the exact https origin, e.g. https://app.example.com
APP_ORIGINS=http://localhost:3000

# LOCAL DEVELOPMENT ONLY. Lets the auth cookie drop the __Host- prefix and the Secure flag so it works
# on http://localhost (Safari rejects Secure cookies there). It is ignored unless every APP_ORIGINS entry
# is an http://localhost origin, and `vercel dev` already implies it. Never set this in Vercel.
# AUTH_ALLOW_INSECURE_COOKIES=true
