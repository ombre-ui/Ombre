{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:__vf(projects|conversations|saved|library)",
      "destination": "/api/workspace"
    },
    {
      "source": "/api/:__vf(projects|conversations|saved|library)/:__vp*",
      "destination": "/api/workspace"
    }
  ]
}
